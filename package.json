{
  "name": "finoraai-dse",
  "version": "1.0.0",
  "description": "Intelligent Personal Finance & Future Simulation System",
  "private": true,
  "scripts": {
    "dev": "concurrently -n \"backend,frontend\" -c \"cyan,magenta\" \"npm run server\" \"npm run client\"",
    "server": "python backend/app.py",
    "client": "npm run dev --prefix frontend",
    "backend": "python backend/app.py",
    "frontend": "npm run dev --prefix frontend",
    "seed": "python backend/seed_data.py",
    "etl": "python -m etl.pipeline",
    "test": "python -m pytest -v",
    "test:backend": "python -m unittest backend/tests/test_calculations.py",
    "build": "npm run build --prefix frontend",
    "lint": "npm run lint --prefix frontend",
    "preview": "npm run preview --prefix frontend"
  },
  "keywords": [
    "finance",
    "simulation",
    "flask",
    "react",
    "vite"
  ],
  "author": "PRASANNAKUMARPR",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^10.0.6"
  }
}
